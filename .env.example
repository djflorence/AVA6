# Ava Configuration - Environment Variables
# Copy this file to .env and fill in your values

# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Model Configuration
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4-turbo
EMOTION_DETECTION_MODEL=SamLowe/roberta-base-go_emotions

# Memory Configuration
CHROMA_DB_DIRECTORY=./chromadb
MEMORY_COLLECTION_NAME=ava_memories

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=ava.log

# Web Search Configuration
SEARCH_ENGINE=duckduckgo
SEARCH_RESULT_COUNT=3

# Emotion Detection Configuration
EMOTION_DETECTION_SENSITIVITY=0.7

# Test Configuration
TEST_RESULTS_DIRECTORY=./test_results

# LLM Configuration
DEFAULT_LLM_MODEL=gpt-4-turbo
ANTHROPIC_MODEL=claude-3-opus-20240229

# Memory Configuration
MEMORY_TYPE=chroma  # Options: chroma, redis, pinecone, etc.
MEMORY_WINDOW_SIZE=10  # Number of recent messages to keep in short-term memory

# Emotion Settings
ENABLE_EMOTIONS=true
EMOTION_SENSITIVITY=0.7  # 0.0 to 1.0, higher means more sensitive

# Tool Configuration
ENABLE_WEB_SEARCH=true
DEFAULT_SEARCH_PROVIDER=duckduckgo  # Options: serpapi, google, duckduckgo, tavily

# Search Provider API Keys
SERPAPI_API_KEY=your_serpapi_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_google_cse_id_here
TAVILY_API_KEY=your_tavily_api_key_here

ENABLE_CALCULATOR=true
ENABLE_WEATHER=false
WEATHER_API_KEY=your_weather_api_key_here

# Application Settings
ENABLE_TRACING=false
MAX_TOKENS=4000
TEMPERATURE=0.7

# Web UI Settings (if applicable)
WEB_UI_PORT=8000
WEB_UI_HOST=127.0.0.1
ENABLE_AUTH=false 