# API Keys for LLM Providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Configuration
DEFAULT_LLM_MODEL=gpt-4-turbo
ANTHROPIC_MODEL=claude-3-opus-20240229
EMBEDDING_MODEL=text-embedding-3-large

# Memory Configuration
MEMORY_TYPE=chroma  # Options: chroma, redis, pinecone, etc.
CHROMA_DB_DIRECTORY=./src/data/chroma
MEMORY_WINDOW_SIZE=10  # Number of recent messages to keep in short-term memory

# Emotion Settings
ENABLE_EMOTIONS=true
EMOTION_SENSITIVITY=0.7  # 0.0 to 1.0, higher means more sensitive

# Tool Configuration
ENABLE_WEB_SEARCH=false
ENABLE_CALCULATOR=true
ENABLE_WEATHER=false
WEATHER_API_KEY=your_weather_api_key_here

# Application Settings
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
ENABLE_TRACING=false
MAX_TOKENS=4000
TEMPERATURE=0.7

# Web UI Settings (if applicable)
WEB_UI_PORT=8000
WEB_UI_HOST=127.0.0.1
ENABLE_AUTH=false 